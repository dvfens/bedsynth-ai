      "rules": [
        {
          "rule_id": "WD-H01",
          "table": "ward_daily",
          "severity": "hard",
          "name": "valid_categories",
          "description": "ward_id, month, day_of_week, staffing_level and occupancy_level take values from their vocabularies.",
          "columns": [
            "ward_id",
            "month",
            "day_of_week",
            "staffing_level",
            "occupancy_level"
          ]
        },
        {
          "rule_id": "WD-H02",
          "table": "ward_daily",
          "severity": "hard",
          "name": "non_negative_integer_counts",
          "description": "Every bed, nurse and patient count (learned and derived) is present, a whole number and not negative.",
          "columns": [
            "bed_capacity",
            "escalation_beds_open",
            "beds_closed",
            "available_beds",
            "nurses_day_shift",
            "nurses_night_shift",
            "census_start",
            "elective_scheduled",
            "elective_cancelled",
            "admissions_elective",
            "admissions_emergency",
            "transfers_in",
            "transfers_out",
            "discharges",
            "discharges_before_noon",
            "census_end",
            "delayed_discharges",
            "emergency_boarders"
          ]
        },
        {
          "rule_id": "WD-H03",
          "table": "ward_daily",
          "severity": "hard",
          "name": "cancellations_within_bookings",
          "description": "A ward cannot cancel more elective admissions than were booked for the day.",
          "columns": [
            "elective_cancelled",
            "elective_scheduled"
          ]
        },
        {
          "rule_id": "WD-H04",
          "table": "ward_daily",
          "severity": "hard",
          "name": "noon_discharges_within_discharges",
          "description": "Discharges completed before noon cannot exceed the day's discharges.",
          "columns": [
            "discharges_before_noon",
            "discharges"
          ]
        },
        {
          "rule_id": "WD-H05",
          "table": "ward_daily",
          "severity": "hard",
          "name": "delayed_within_census",
          "description": "Patients medically fit but awaiting discharge at midnight cannot exceed the midnight census.",
          "columns": [
            "delayed_discharges",
            "census_start"
          ]
        },
        {
          "rule_id": "WD-H06",
          "table": "ward_daily",
