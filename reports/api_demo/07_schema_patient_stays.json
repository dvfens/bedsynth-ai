      "rules": [
        {
          "rule_id": "PS-H01",
          "table": "patient_stays",
          "severity": "hard",
          "name": "valid_categories",
          "description": "All categorical stay attributes take values from their vocabularies.",
          "columns": [
            "ward_id",
            "admission_source",
            "admission_month",
            "admission_day_of_week",
            "separation_type",
            "discharge_destination",
            "delay_reason"
          ]
        },
        {
          "rule_id": "PS-H02",
          "table": "patient_stays",
          "severity": "hard",
          "name": "hours_in_range",
          "description": "Admission and departure hours are whole hours between 0 and 23.",
          "columns": [
            "admission_hour",
            "discharge_hour"
          ]
        },
        {
          "rule_id": "PS-H03",
          "table": "patient_stays",
          "severity": "hard",
          "name": "non_negative_values",
          "description": "Counts are whole and not negative, bed wait and discharge delay hours are not negative, and none is missing.",
          "columns": [
            "booking_lead_days",
            "times_rescheduled",
            "los_nights",
            "bed_turnaround_minutes",
            "bed_wait_hours",
            "discharge_delay_hours"
          ]
        },
        {
          "rule_id": "PS-H04",
          "table": "patient_stays",
          "severity": "hard",
          "name": "positive_length_of_stay",
          "description": "Every stay lasts at least one hour.",
          "columns": [
            "los_hours"
          ]
        },
        {
          "rule_id": "PS-H05",
          "table": "patient_stays",
          "severity": "hard",
          "name": "elective_booking_lead",
          "description": "Elective admissions are booked at least one day in advance.",
          "columns": [
            "admission_source",
            "booking_lead_days"
          ]
        },
        {
          "rule_id": "PS-H06",
          "table": "patient_stays",
          "severity": "hard",
          "name": "non_elective_unbooked",
          "description": "Emergency and transfer admissions have no booking lead time and were never rescheduled.",
          "columns": [
            "admission_source",
            "booking_lead_days",
            "times_rescheduled"
          ]
        },
        {
          "rule_id": "PS-H07",
          "table": "patient_stays",
          "severity": "hard",
          "name": "delay_reason_consistent",
          "description": "A delay reason is recorded exactly when the departure was delayed ('none' if and only if zero delay hours).",
          "columns": [
            "delay_reason",
            "discharge_delay_hours"
          ]
        },
        {
          "rule_id": "PS-H08",
          "table": "patient_stays",
          "severity": "hard",
          "name": "delay_within_stay",
          "description": "The discharge delay cannot be longer than the stay itself.",
          "columns": [
            "discharge_delay_hours",
            "los_hours"
          ]
        },
        {
          "rule_id": "PS-H09",
          "table": "patient_stays",
          "severity": "hard",
          "name": "separation_destination_consistent",
          "description": "Stays that end in an internal transfer go to another ward, and only those do.",
          "columns": [
            "separation_type",
            "discharge_destination"
          ]
        },
        {
          "rule_id": "PS-H10",
          "table": "patient_stays",
          "severity": "hard",
          "name": "delay_reason_allowed",
          "description": "The delay reason is operationally meaningful for the discharge destination.",
          "columns": [
            "delay_reason",
            "discharge_destination"
          ]
        },
        {
          "rule_id": "PS-H11",
          "table": "patient_stays",
          "severity": "hard",
          "name": "ward_admission_profile",
          "description": "The admission source is one the ward accepts.",
          "columns": [
            "ward_id",
            "admission_source"
          ]
        },
        {
          "rule_id": "PS-H12",
          "table": "patient_stays",
          "severity": "hard",
          "name": "metric_ranges",
          "description": "Bed turnaround is 10-1440 min, bed wait at most 96 h, stays at most 180 nights, booking lead at most 365 days and reschedules at most 10.",
          "columns": [
            "bed_turnaround_minutes",
            "bed_wait_hours",
            "los_nights",
            "booking_lead_days",
            "times_rescheduled"
          ]
        },
        {
          "rule_id": "PS-H13",
          "table": "patient_stays",
          "severity": "hard",
          "name": "delay_threshold",
          "description": "A departure counts as delayed only when it is more than 4 hours after the patient was ready, so recorded delays are either zero or at least 4 hours.",
          "columns": [
            "discharge_delay_hours"
          ]
        },
        {
          "rule_id": "PS-H14",
          "table": "patient_stays",
          "severity": "hard",
          "name": "rebooking_lead",
          "description": "Postponed electives are rebooked at least seven days later, so the booking lead is at least 1 + 7 x times_rescheduled days.",
          "columns": [
            "admission_source",
            "booking_lead_days",
            "times_rescheduled"
          ]
        },
        {
          "rule_id": "PS-S01",
          "table": "patient_stays",
          "severity": "soft",
          "name": "elective_admission_hours",
          "description": "Elective patients are admitted between 06:00 and 14:59.",
          "columns": [
            "admission_source",
            "admission_hour"
          ]
        },
        {
          "rule_id": "PS-S02",
          "table": "patient_stays",
          "severity": "soft",
          "name": "daytime_departures",
          "description": "Patients leave the ward between 07:00 and 22:59.",
          "columns": [
            "discharge_hour"
          ]
        },
        {
          "rule_id": "PS-S03",
          "table": "patient_stays",
          "severity": "soft",
          "name": "short_elective_wait",
          "description": "Elective patients wait at most four hours for their bed.",
          "columns": [
            "admission_source",
            "bed_wait_hours"
          ]
        },
        {
          "rule_id": "PS-S04",
          "table": "patient_stays",
          "severity": "soft",
          "name": "no_paediatric_transfers_out",
          "description": "Paediatric stays do not end in an internal transfer.",
